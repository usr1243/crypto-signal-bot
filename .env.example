# ============================================================
# Boerse & Symbol (Stufe 0/1) -- oeffentliche Endpunkte, kein Key noetig
# ============================================================
EXCHANGE=kraken
SYMBOL=BTC/USD
SYMBOLS=BTC/USD,ETH/USD          # nur fuer run_loop.py (mehrere Symbole gleichzeitig)
TIMEFRAME=1h
# Nur fuer run_loop.py: mehrere UNABHAENGIGE Zeitebenen gleichzeitig, jede mit
# eigenem Takt und eigenen Telegram-Alerts (kein Vermischen zu einer Entscheidung
# wie bei freqtrades "Informative Pairs" -- das macht main.py schon separat
# ueber den Trendfilter). Default: nur TIMEFRAME oben. Beispiel: TIMEFRAMES=1h,15m
TIMEFRAMES=1h
# Totmann-Schalter (Stufe A3): run_loop.py meldet sich alle N Stunden per
# Telegram, auch wenn nichts passiert ist. Bleibt die Meldung aus, ist etwas
# kaputt -- das faellt dann in Stunden auf statt wie am 04.09.2026 nach 18h
# stillem Netzausfall.
HEARTBEAT_INTERVAL_HOURS=6

# ============================================================
# Telegram (Stufe 0/1) -- ohne diese zwei Zeilen: Dry-Run auf der Konsole
# ============================================================
# Bot anlegen: Telegram -> @BotFather -> /newbot -> Token kopieren
# Chat-ID finden: Bot antworten lassen, dann https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Admin/Kollege-Rollentrennung: deine eigene Telegram-User-ID (NICHT die
# Chat-ID!). Herausfinden: @userinfobot in Telegram anschreiben, zeigt sie an.
# Ohne diese Zeile: keine Rollentrennung, jeder wird direkt beantwortet.
# Mit dieser Zeile: nur du kannst /pause /resume /approve /reject -- alle
# anderen (z.B. der Kollege in einer gemeinsamen Gruppe) werden mit ihren
# Nachrichten als Aenderungswunsch gespeichert, nie direkt umgesetzt.
ADMIN_TELEGRAM_USER_ID=

# ============================================================
# Schicht B / Makro (Stufe 3) -- main.py braucht --with-macro, sonst ungenutzt
# ============================================================
WITH_MACRO=false

# ============================================================
# Risiko-/Zielvorgaben pro Trade
# ============================================================
# Gewinnziel als Vielfaches der Stop-Distanz. 3.0 = Ziel liegt dreimal so weit
# weg wie der Stop. Vorher war das im Live-Pfad hart auf 2.0 verdrahtet.
# Mit `python -m src.optimize` laesst sich messen, welcher Wert auf der
# Historie tatsaechlich am besten abschneidet -- nicht raten.
REWARD_RISK_RATIO=3.0
# Stop-Distanz in ATR-Vielfachen (Volatilitaetsmass). Groesser = weiterer Stop
# = seltener ausgestoppt, aber jeder Verlust kostet mehr Preisbewegung.
ATR_MULTIPLE=2.0

# Gratis-Key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Gratis-Key (Dev-Tier): https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# LLM-Backend fuer die Makro-Synthese -- frei waehlbar, nicht an einen
# Anbieter gebunden:
#   "cli"  -- 0 CHF, Claude-Pro-Kontingent, braucht `claude` im PATH + eingeloggt
#   "api"  -- ~2-5 USD/Monat, braucht ANTHROPIC_API_KEY (Claude Sonnet 5)
#   "groq" -- 0 CHF, Gratis-Tier ohne Kreditkarte, braucht GROQ_API_KEY.
#             Default-Modell: openai/gpt-oss-120b (offenes Reasoning-Modell
#             von OpenAI, im Gratis-Tier enthalten, Denkaufwand einstellbar).
#             Key: https://console.groq.com/keys
#   "mock" -- kein echtes LLM, nur fuer Pipeline-Tests
#   "auto" -- nimmt LLM_BACKEND falls gesetzt, sonst Anthropic-Key falls
#             vorhanden, sonst Groq-Key falls vorhanden, sonst cli
LLM_BACKEND=auto
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ============================================================
# Stufe 5 -- ECHTE Order-Ausfuehrung. Standard: AUS. Nur aendern, wenn
# Stufe 4 (Paper-Trading, siehe PLAN.md) abgeschlossen ist UND es die
# Keys des Kontoinhabers sind (nie Lorenz' eigene). Key-Rechte: NUR
# "Trade", NIEMALS "Withdrawal".
# ============================================================
LIVE_TRADING_ENABLED=false
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
ACCOUNT_SIZE_QUOTE_CCY=          # z.B. 1000 (USD) -- fuer die Positionsgroessen-Berechnung beim Ausfuehren

# ============================================================
# PLAN Stufe C10 -- Fernsteuerung des NEUEN freqtrade-Systems (bot/freqtrade/)
# ueber Telegram (/ft_status /ft_pause /ft_resume /ft_forceexit /ft_panic).
# Nur fuer den Admin nutzbar, siehe ADMIN_TELEGRAM_USER_ID oben. Ohne diese
# drei Zeilen antworten die /ft_*-Befehle nur mit "nicht konfiguriert" --
# das bisherige System (run_loop.py/telegram_listener.py fuer /status /pause
# usw.) laeuft unabhaengig davon unveraendert weiter.
# ============================================================
# JWT-Secret fuer freqtrades REST-API, mind. 32 Zeichen. Erzeugen z.B. mit:
#   openssl rand -hex 32
# Wird NUR von freqtrade selbst gebraucht (siehe freqtrade/docker-compose.yml),
# telegram_listener.py braucht diese Variable nicht.
FREQTRADE_API_JWT_SECRET=
# Freiwaehlbare Zugangsdaten fuer freqtrades REST-API -- dieselben zwei Werte
# werden von BEIDEN Seiten gelesen (freqtrade selbst als Server, telegram_listener.py
# als Client), muessen also hier nur einmal stehen.
FREQTRADE_API_USER=
FREQTRADE_API_PASS=
# FREQTRADE_API_URL nicht hier noetig -- steht bereits fest in
# bot/docker-compose.yml (interne Container-Adresse, kein Geheimnis).
